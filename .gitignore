# Python bytecode and caches
__pycache__/
*.py[cod]

# Numba's JIT cache. With cache=True these land inside __pycache__ and are
# already covered, but a NUMBA_CACHE_DIR override writes them loose.
*.nbi
*.nbc

# Virtual environments
/.venv/
venv/
env/

# Packaging and build artifacts
/build/
/dist/
*.egg-info/
.eggs/

# Test, lint and type-check caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Derived results: the cached ground-truth V* and the per-run JSON traces.
# These are regenerated by scripts/reproduce_all.sh, and a stale cache left in
# the tree is exactly what makes that script pass spuriously. Never commit one.
*.npz
/results/
/cache/

# Figures referenced by the README are committed on purpose. If a pattern above
# ever starts catching one, force it in with `git add -f` rather than loosening
# the rules that keep derived data out.

# Environment files
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
._*

# Vim / Neovim temporary and session files
*.swp
*.swo
*.swn
*~
Session.vim
Sessionx.vim
.shada

# Other editors
.vscode/
.idea/
